# Copy to .env (same folder) and fill in. .env is never committed.

# Admin page login (office LAN). Password: 8+ characters, not a default.
PERMIT_ADMIN_USER=facilities
PERMIT_ADMIN_PASSWORD=
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PERMIT_JWT_SECRET=

# Where the admin page listens. 0.0.0.0 = every network interface (LAN); 127.0.0.1 = this server only.
PERMIT_HOST=0.0.0.0
PERMIT_PORT=5100

# Optional overrides
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PERMIT_DATA_DIR=D:\whatsabot\parking-permit\parkpermit\data
# WHATSABOT_SERVER_DIR=D:\whatsabot\server     (where baileys/express are installed)
