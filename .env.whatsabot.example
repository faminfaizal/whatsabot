# Copy to .env.whatsabot and fill in. Never commit the real file.

# Admin panel (http://10.49.39.144:8058/admin). Admin login is refused until all three are set;
# the password can't be "admin123" and the secret can't be "secret"/"changeme".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Defaults for new users (also editable on the admin page)
DEFAULT_CREDITS=100
MIN_DELAY_MS=3000
MAX_DELAY_MS=8000
MAX_PER_RUN=50
MAX_PER_HOUR=30
MAX_PER_DAY=200
SAFE_HOURS_START=8
SAFE_HOURS_END=21
AUTO_PAUSE_FAILURES=3
COOLDOWN_MINUTES=5

# Scraper feed (leave blank to disable)
SCRAPER_FEED_URL=
SCRAPER_CALLBACK_URL=
SCRAPER_CALLBACK_KEY=
